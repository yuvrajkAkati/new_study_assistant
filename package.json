{
  "name": "study-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "Paste notes or a topic, get AI-generated flashcards or a quiz, then re-test what you got wrong.",
  "type": "module",
  "scripts": {
    "start": "vite build && node server/index.js",
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "test": "node --test \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
